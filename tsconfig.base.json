{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": false,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,
    "rootDir": ".",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "types": ["*"],
    "paths": {
      "@portfolio-monorepo/portfolio/data": [
        "./libs/portfolio/data/src/index.ts"
      ],
      "@portfolio-monorepo/portfolio/util": [
        "./libs/portfolio/util/src/index.ts"
      ],
      "@portfolio-monorepo/shared/data": ["./libs/shared/data/src/index.ts"],
      "@portfolio-monorepo/shared/util": ["./libs/shared/util/src/index.ts"],
      "@portfolio-monorepo/test/portfolio-e2e": [
        "./libs/test/portfolio-e2e/src/index.ts"
      ],
      "@portfolio-monorepo/shared/ui/theme-toggle": [
        "./libs/shared/ui/theme-toggle/src/index.ts"
      ],
      "@portfolio-monorepo/shared/ui/back-to-top": [
        "./libs/shared/ui/back-to-top/src/index.ts"
      ],
      "@portfolio-monorepo/shared/ui/magic-cursor": [
        "./libs/shared/ui/magic-cursor/src/index.ts"
      ],
      "@portfolio-monorepo/shared/ui/scroll-spy": [
        "./libs/shared/ui/scroll-spy/src/index.ts"
      ],
      "@portfolio-monorepo/shared/ui/site-menu": [
        "./libs/shared/ui/site-menu/src/index.ts"
      ],
      "@portfolio-monorepo/portfolio/ui/typing-title": [
        "./libs/portfolio/ui/typing-title/src/index.ts"
      ],
      "@portfolio-monorepo/portfolio/ui/profile-panel": [
        "./libs/portfolio/ui/profile-panel/src/index.ts"
      ],
      "@portfolio-monorepo/portfolio/ui/tabs": [
        "./libs/portfolio/ui/tabs/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
